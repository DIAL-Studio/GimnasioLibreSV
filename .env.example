# ─────────────────────────────────────────────────────────────────────────────
# GimnasioLibreSV — environment configuration
#
# Copy this file and edit it:   cp .env.example .env
#
# THE PASSKEY RULE (read this):
#   • RP_ID  must be EXACTLY the site's hostname — no https://, no port, no path.
#   • ORIGIN must be the EXACT public URL — with https:// and no trailing slash.
#   • Passkeys only work over HTTPS (the one exception is http://localhost).
#   • Changing RP_ID after people register invalidates their passkeys, so pick
#     your domain before you invite anyone.
#
# For a VPS deployment with automatic HTTPS see docs/SELF_HOSTING.md.
# ─────────────────────────────────────────────────────────────────────────────

# Hostname passkeys are bound to. Local dev: localhost
RP_ID=localhost

# Exact public URL the app is served from. Local dev: http://localhost:8080
ORIGIN=http://localhost:8080

# Host port for the web UI. Behind a reverse proxy this should bind 127.0.0.1 only.
WEB_PORT=8080

# Name shown in the passkey prompt (usually the gym's name).
RP_NAME=GimnasioLibreSV

# ── Optional ─────────────────────────────────────────────────────────────────

# Comma-separated user ids that get the admin dashboard. Register your passkey
# first, then copy your id from ./data/db.json → users[].id.
# ADMIN_UIDS=

# Require an invite code to create a profile (1 = on). Off by default.
# INVITE_ONLY=

# Session lifetime in days (default 90).
# SESSION_DAYS=90

# Contact address for Web Push (mailto:you@example.com). Defaults to ORIGIN.
# VAPID_SUBJECT=mailto:admin@example.com
